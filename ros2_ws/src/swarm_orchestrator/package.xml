<?xml version="1.0"?>
<package format="3">
  <name>swarm_orchestrator</name>
  <version>0.1.0</version>
  <description>Central state machine for semantic congestion intervention.</description>
  <maintainer email="maintainer@example.com">VGU VLM Swarm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>swarm_interfaces</depend>
  <!-- Stage-2 set-of-mark drawing reuses M1's calibration loader and its
       world-to-pixel homography helper. -->
  <exec_depend>swarm_perception</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
