{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoordinationCommand",
  "type": "object",
  "required": ["command_id", "actions", "expected_resolution_time_sec", "fallback"],
  "properties": {
    "command_id": { "type": "string" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["robot_id", "action"],
        "properties": {
          "robot_id": { "type": "string" },
          "action": { "type": "string" },
          "parameters": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "expected_resolution_time_sec": { "type": "number", "minimum": 0 },
    "fallback": { "type": "string" },
    "degradations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
