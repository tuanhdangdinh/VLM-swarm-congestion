.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.worktrees/

# ROS2 build outputs
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Runtime/generated data
data/logs/*
!data/logs/.gitkeep
data/vector_store/*
!data/vector_store/.gitkeep
data/generated/isaac/*
!data/generated/isaac/.gitkeep
benchmarks/results/*
!benchmarks/results/.gitkeep

# Large local artifacts
*.bag
*.db3
*.pt
*.pth
*.onnx
*.engine

# Secrets — never commit real keys (see .env.example for required vars)
.env
.env.local

# Tool-local/session dirs and machine state (state/ holds private keys)
.claire/
.claude/
.codex/
.superpowers/
.vscode/
tmp/
state/
docs/note/
# macOS AppleDouble files
._*
**/._*
data/demo/
