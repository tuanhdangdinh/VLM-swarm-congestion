<?xml version="1.0"?>
<package format="3">
  <name>swarm_execution</name>
  <version>0.1.0</version>
  <description>Coordination command dispatch, robot clients, Nav2 adapter, and safety.</description>
  <maintainer email="maintainer@example.com">VGU VLM Swarm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>swarm_interfaces</depend>
  <depend>ament_index_python</depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- stall_abort.py config/verdict models; the same container already runs
       swarm_perception, which needs it too. -->
  <exec_depend>python3-pydantic</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
